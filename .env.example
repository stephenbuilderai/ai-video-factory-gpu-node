# ─── Operating Mode ───────────────────────────────────────────────────────────
# Set to "true" to use HTTP API mode (no shared filesystem needed)
# Set to "" or omit to use shared-folder queue mode (legacy)
API_MODE=true

# Container API base URL (include trailing slash)
# Format: http://<container-public-ip>:<docker-port>
# Docker port is the internal port mapped to the container
# e.g. if container port 43988 → http://187.124.2.245:43988
API_URL=http://187.124.2.245:43988

# Bearer token for container API auth
# Get from: openclaw config get gateway.auth.token
API_TOKEN=LNwpCSW9zcB1W2rHh9kAmpHKiYtZu83B

# ─── Render Worker ────────────────────────────────────────────────────────────
# Path to the Remotion render-worker project on this machine
REMOTION_PROJECT_ROOT=C:/Projects/ai-video-factory/systems/ai-video-factory/render-worker

# ─── Google Drive ────────────────────────────────────────────────────────────
GDRIVE_FOLDER_ID=0ABS7lV30kSIDUk9PVA
GDRIVE_TOKEN=ya29.a0AfH6SMB...

# ─── Dashboard ───────────────────────────────────────────────────────────────
PORT=3000

# Poll interval in ms (default 3000)
POLL_INTERVAL_MS=3000

# ─── Render options ──────────────────────────────────────────────────────────
DISABLE_GPU_SANDBOX=false
